{
  "name": "ender",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ender/server --filter @ender/game dev",
    "start": "pnpm dev",
    "service": "pnpm --filter @ender/reality-service start",
    "service:dev": "pnpm --filter @ender/reality-service dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:no-paid-inference": "vitest run tests/no-paid-inference",
    "data:sync:pubchem": "tsx scripts/sync-pubchem.ts",
    "data:sync:markets": "tsx scripts/sync-markets.ts",
    "data:sync:openalex": "tsx scripts/sync-openalex.ts",
    "data:sync": "pnpm data:sync:pubchem && pnpm data:sync:markets && pnpm data:sync:openalex",
    "data:build": "tsx scripts/build-candidates.ts",
    "fixtures:list": "tsx scripts/fixture-list.ts",
    "fixtures:validate": "tsx scripts/fixture-validate.ts",
    "fixtures:collect": "tsx scripts/fixture-collect.ts",
    "build:web": "pnpm --filter @ender/game build:web && tsx scripts/bundle-web.ts",
    "dev:web": "pnpm --filter @ender/game dev:web"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@ender/content": "workspace:*",
    "@ender/domain": "workspace:*",
    "@ender/economy": "workspace:*",
    "@ender/inference": "workspace:*",
    "@ender/reality": "workspace:*",
    "@ender/shared": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
