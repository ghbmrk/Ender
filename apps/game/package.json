{
  "name": "@ender/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:web": "vite --mode web",
    "build:web": "vite build --mode web --outDir dist-web --base ./",
    "build:split": "vite build --mode split --outDir dist-split --base ./",
