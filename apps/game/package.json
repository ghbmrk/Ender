  },
  "dependencies": {
    "@ender/battle": "workspace:*",
    "@ender/content": "workspace:*",
    "@ender/domain": "workspace:*",
    "@ender/economy": "workspace:*",
    "@ender/inference": "workspace:*",
    "@ender/reality": "workspace:*",
    "@ender/server": "workspace:*",
    "@ender/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
